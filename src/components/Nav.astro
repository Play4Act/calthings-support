---
import { t, LANGS, getLangLabel, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  currentPage: string;
}

const { lang, currentPage } = Astro.props;
const i18n = t[lang];

const pathSuffix = Astro.url.pathname.replace(/^\/(zh|en|ja)/, '') || '/';

const navLinks = [
  { key: 'home', label: i18n.nav.home, href: `/${lang}/` },
  { key: 'announcements', label: i18n.nav.announcements, href: `/${lang}/announcements/` },
  { key: 'faq', label: i18n.nav.faq, href: `/${lang}/faq/` },
  { key: 'terms', label: i18n.nav.terms, href: `/${lang}/terms/` },
  { key: 'privacy', label: i18n.nav.privacy, href: `/${lang}/privacy/` },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm">
  <!-- Row 1: Logo + Nav tabs -->
  <div class="max-w-5xl mx-auto px-4 h-12 flex items-center gap-3">
    <a href={`/${lang}/`} class="flex items-center gap-2 shrink-0 font-bold text-ocean-deep text-lg mr-2">
      <img src="/favicon.png" alt="CalThings" class="w-7 h-7 rounded-lg" />
      <span class="hidden sm:inline">CalThings</span>
    </a>
    <nav class="flex items-center gap-0.5 overflow-x-auto">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={[
            'px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors',
            currentPage === link.key
              ? 'bg-ocean-foam text-ocean-deep'
              : 'text-gray-600 hover:text-ocean-deep hover:bg-gray-50',
          ].join(' ')}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Row 2: Language switcher -->
  <div class="border-t border-gray-100 bg-gray-50/70">
    <div class="max-w-5xl mx-auto px-4 h-8 flex items-center gap-1">
      {LANGS.map(l => (
        <a
          href={`/${l}${pathSuffix}`}
          class={[
            'px-3 py-0.5 rounded-md text-xs font-semibold transition-colors',
            l === lang
              ? 'bg-ocean-deep text-white'
              : 'text-gray-500 hover:bg-gray-200',
          ].join(' ')}
        >
          {getLangLabel(l)}
        </a>
      ))}
    </div>
  </div>
</header>

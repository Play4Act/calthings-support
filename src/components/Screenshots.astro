---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = t[lang];

const labels = {
  zh: {
    expense: '新增支出', stats: '統計', calendar: '日曆',
    food: '餐飲', shop: '購物', traffic: '交通', other: '其他',
    monthSpend: '本月支出', budget: '預算',
    catFood: '餐飲', catShop: '購物', catTraffic: '交通',
    lunarLabel: '農曆 四月廿一', reminder: '繳水電費', reminderTime: '今天 18:00',
  },
  en: {
    expense: 'New Expense', stats: 'Statistics', calendar: 'Calendar',
    food: 'Food', shop: 'Shop', traffic: 'Transit', other: 'Other',
    monthSpend: 'This Month', budget: 'Budget',
    catFood: 'Food', catShop: 'Shop', catTraffic: 'Transit',
    lunarLabel: 'Lunar Apr 21', reminder: 'Pay Utilities', reminderTime: 'Today 18:00',
  },
  ja: {
    expense: '支出追加', stats: '統計', calendar: 'カレンダー',
    food: '食費', shop: '買物', traffic: '交通', other: 'その他',
    monthSpend: '今月支出', budget: '予算',
    catFood: '食費', catShop: '買物', catTraffic: '交通',
    lunarLabel: '旧暦 4月21日', reminder: '光熱費支払い', reminderTime: '今日 18:00',
  },
}[lang];
---

<section class="bg-gradient-to-b from-white to-blue-50/40 py-16 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-2">{i18n.screenshots.title}</h2>
      <p class="text-gray-500">{i18n.hero.tagline}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">

      <!-- Mockup 1: POS-style entry -->
      <div class="flex flex-col items-center group">
        <div class="relative mb-5 transition-transform duration-300 group-hover:-translate-y-1">
          <svg viewBox="0 0 280 560" class="w-48 h-auto drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
            <!-- Phone frame -->
            <rect x="2" y="2" width="276" height="556" rx="44" fill="#1D2226" stroke="#404548" stroke-width="2"/>
            <rect x="10" y="10" width="260" height="540" rx="36" fill="#FFFDF5"/>
            <!-- Notch -->
            <rect x="100" y="18" width="80" height="22" rx="11" fill="#1D2226"/>
            <!-- Status bar text -->
            <text x="32" y="32" font-family="-apple-system, sans-serif" font-size="11" font-weight="600" fill="#1D2226">9:41</text>
            <!-- Header -->
            <text x="140" y="74" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="14" font-weight="700" fill="#1D2226">{labels.expense}</text>

            <!-- Amount display card -->
            <rect x="22" y="92" width="236" height="86" rx="18" fill="#2173B3"/>
            <text x="40" y="120" font-family="-apple-system, sans-serif" font-size="11" font-weight="500" fill="#B3DEF5">NT$</text>
            <text x="40" y="158" font-family="-apple-system, sans-serif" font-size="36" font-weight="800" fill="#FFFFFF">150</text>

            <!-- Category chips -->
            <g transform="translate(22, 192)">
              <rect width="56" height="48" rx="14" fill="#FFF0EB"/>
              <circle cx="28" cy="20" r="9" fill="#FF7D4F"/>
              <text x="28" y="42" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="9" font-weight="600" fill="#1D2226">{labels.food}</text>

              <rect x="62" width="56" height="48" rx="14" fill="#E8F4FD"/>
              <circle cx="90" cy="20" r="9" fill="#409ED9"/>
              <text x="90" y="42" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="9" font-weight="600" fill="#1D2226">{labels.shop}</text>

              <rect x="124" width="56" height="48" rx="14" fill="#E6F9F1"/>
              <circle cx="152" cy="20" r="9" fill="#33C791"/>
              <text x="152" y="42" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="9" font-weight="600" fill="#1D2226">{labels.traffic}</text>

              <rect x="186" width="50" height="48" rx="14" fill="#F3E8FA"/>
              <circle cx="211" cy="20" r="9" fill="#8F45AD"/>
              <text x="211" y="42" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="9" font-weight="600" fill="#1D2226">{labels.other}</text>
            </g>

            <!-- Number pad -->
            <g transform="translate(22, 264)" font-family="-apple-system, sans-serif" font-size="18" font-weight="600" fill="#1D2226" text-anchor="middle">
              <rect width="72" height="48" rx="14" fill="#F4F6F8"/><text x="36" y="32">1</text>
              <rect x="82" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="118" y="32">2</text>
              <rect x="164" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="200" y="32">3</text>

              <rect y="58" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="36" y="90">4</text>
              <rect x="82" y="58" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="118" y="90">5</text>
              <rect x="164" y="58" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="200" y="90">6</text>

              <rect y="116" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="36" y="148">7</text>
              <rect x="82" y="116" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="118" y="148">8</text>
              <rect x="164" y="116" width="72" height="48" rx="14" fill="#F4F6F8"/><text x="200" y="148">9</text>
            </g>

            <!-- Confirm button -->
            <rect x="22" y="464" width="236" height="56" rx="18" fill="#2173B3"/>
            <text x="140" y="498" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="16" font-weight="700" fill="#FFFFFF">✓</text>

            <!-- Home indicator -->
            <rect x="100" y="538" width="80" height="4" rx="2" fill="#1D2226"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-900 mb-1">{i18n.screenshots.items[0].title}</h3>
        <p class="text-sm text-gray-500 text-center max-w-[220px]">{i18n.screenshots.items[0].desc}</p>
      </div>

      <!-- Mockup 2: Budget & Statistics -->
      <div class="flex flex-col items-center group sm:translate-y-4">
        <div class="relative mb-5 transition-transform duration-300 group-hover:-translate-y-1">
          <svg viewBox="0 0 280 560" class="w-48 h-auto drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="276" height="556" rx="44" fill="#1D2226" stroke="#404548" stroke-width="2"/>
            <rect x="10" y="10" width="260" height="540" rx="36" fill="#FFFDF5"/>
            <rect x="100" y="18" width="80" height="22" rx="11" fill="#1D2226"/>
            <text x="32" y="32" font-family="-apple-system, sans-serif" font-size="11" font-weight="600" fill="#1D2226">9:41</text>
            <text x="140" y="74" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="14" font-weight="700" fill="#1D2226">{labels.stats}</text>

            <!-- Summary card -->
            <rect x="22" y="92" width="236" height="74" rx="18" fill="url(#statsGrad)"/>
            <defs>
              <linearGradient id="statsGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#2173B3"/>
                <stop offset="100%" stop-color="#73C2ED"/>
              </linearGradient>
            </defs>
            <text x="40" y="118" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="10" font-weight="500" fill="#B3DEF5">{labels.monthSpend}</text>
            <text x="40" y="148" font-family="-apple-system, sans-serif" font-size="24" font-weight="800" fill="#FFFFFF">$ 12,840</text>

            <!-- Donut chart -->
            <g transform="translate(140, 240)">
              <!-- coral 45% -->
              <circle r="48" fill="none" stroke="#FF7D4F" stroke-width="22"
                      stroke-dasharray="135.7 301.6" transform="rotate(-90)"/>
              <!-- blue 30% -->
              <circle r="48" fill="none" stroke="#409ED9" stroke-width="22"
                      stroke-dasharray="90.5 301.6" stroke-dashoffset="-135.7" transform="rotate(-90)"/>
              <!-- green 25% -->
              <circle r="48" fill="none" stroke="#33C791" stroke-width="22"
                      stroke-dasharray="75.4 301.6" stroke-dashoffset="-226.2" transform="rotate(-90)"/>
              <text y="6" text-anchor="middle" font-family="-apple-system, sans-serif" font-size="18" font-weight="800" fill="#1D2226">100%</text>
            </g>

            <!-- Category list -->
            <g transform="translate(22, 320)">
              <g>
                <circle cx="12" cy="12" r="6" fill="#FF7D4F"/>
                <text x="28" y="16" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="12" font-weight="600" fill="#1D2226">{labels.catFood}</text>
                <text x="216" y="16" text-anchor="end" font-family="-apple-system, sans-serif" font-size="12" font-weight="600" fill="#1D2226">$5,778</text>
                <rect x="0" y="22" width="236" height="4" rx="2" fill="#FFE0D5"/>
                <rect x="0" y="22" width="106" height="4" rx="2" fill="#FF7D4F"/>
              </g>
              <g transform="translate(0, 42)">
                <circle cx="12" cy="12" r="6" fill="#409ED9"/>
                <text x="28" y="16" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="12" font-weight="600" fill="#1D2226">{labels.catShop}</text>
                <text x="216" y="16" text-anchor="end" font-family="-apple-system, sans-serif" font-size="12" font-weight="600" fill="#1D2226">$3,852</text>
                <rect x="0" y="22" width="236" height="4" rx="2" fill="#D0EBFA"/>
                <rect x="0" y="22" width="71" height="4" rx="2" fill="#409ED9"/>
              </g>
              <g transform="translate(0, 84)">
                <circle cx="12" cy="12" r="6" fill="#33C791"/>
                <text x="28" y="16" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="12" font-weight="600" fill="#1D2226">{labels.catTraffic}</text>
                <text x="216" y="16" text-anchor="end" font-family="-apple-system, sans-serif" font-size="12" font-weight="600" fill="#1D2226">$3,210</text>
                <rect x="0" y="22" width="236" height="4" rx="2" fill="#CCF2E3"/>
                <rect x="0" y="22" width="59" height="4" rx="2" fill="#33C791"/>
              </g>
            </g>

            <!-- Bar chart hint -->
            <g transform="translate(22, 444)">
              <rect width="236" height="76" rx="14" fill="#F4F6F8"/>
              <rect x="14" y="44" width="20" height="22" rx="3" fill="#73C2ED"/>
              <rect x="42" y="34" width="20" height="32" rx="3" fill="#73C2ED"/>
              <rect x="70" y="22" width="20" height="44" rx="3" fill="#409ED9"/>
              <rect x="98" y="38" width="20" height="28" rx="3" fill="#73C2ED"/>
              <rect x="126" y="14" width="20" height="52" rx="3" fill="#2173B3"/>
              <rect x="154" y="28" width="20" height="38" rx="3" fill="#409ED9"/>
              <rect x="182" y="42" width="20" height="24" rx="3" fill="#73C2ED"/>
            </g>

            <rect x="100" y="538" width="80" height="4" rx="2" fill="#1D2226"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-900 mb-1">{i18n.screenshots.items[1].title}</h3>
        <p class="text-sm text-gray-500 text-center max-w-[220px]">{i18n.screenshots.items[1].desc}</p>
      </div>

      <!-- Mockup 3: Calendar + Reminder -->
      <div class="flex flex-col items-center group">
        <div class="relative mb-5 transition-transform duration-300 group-hover:-translate-y-1">
          <svg viewBox="0 0 280 560" class="w-48 h-auto drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="276" height="556" rx="44" fill="#1D2226" stroke="#404548" stroke-width="2"/>
            <rect x="10" y="10" width="260" height="540" rx="36" fill="#FFFDF5"/>
            <rect x="100" y="18" width="80" height="22" rx="11" fill="#1D2226"/>
            <text x="32" y="32" font-family="-apple-system, sans-serif" font-size="11" font-weight="600" fill="#1D2226">9:41</text>
            <text x="140" y="74" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="14" font-weight="700" fill="#1D2226">{labels.calendar}</text>

            <!-- Month label -->
            <text x="22" y="110" font-family="-apple-system, sans-serif" font-size="20" font-weight="800" fill="#1D2226">2026</text>
            <text x="22" y="132" font-family="-apple-system, sans-serif" font-size="14" font-weight="600" fill="#86868b">May / 五月</text>

            <!-- Lunar tag -->
            <rect x="160" y="100" width="98" height="32" rx="16" fill="#F3E8FA"/>
            <text x="209" y="121" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="11" font-weight="600" fill="#8F45AD">{labels.lunarLabel}</text>

            <!-- Calendar grid header -->
            <g transform="translate(22, 156)" font-family="-apple-system, sans-serif" font-size="10" font-weight="600" fill="#86868b" text-anchor="middle">
              <text x="16">S</text><text x="50">M</text><text x="84">T</text><text x="118">W</text><text x="152">T</text><text x="186">F</text><text x="220">S</text>
            </g>

            <!-- Calendar grid -->
            <g transform="translate(22, 174)" font-family="-apple-system, sans-serif" font-size="11" font-weight="500" text-anchor="middle">
              <!-- Row 1 -->
              <text x="16" y="14" fill="#C4C4C6">26</text><text x="50" y="14" fill="#C4C4C6">27</text><text x="84" y="14" fill="#C4C4C6">28</text>
              <text x="118" y="14" fill="#C4C4C6">29</text><text x="152" y="14" fill="#C4C4C6">30</text><text x="186" y="14" fill="#1D2226">1</text><text x="220" y="14" fill="#1D2226">2</text>
              <!-- Row 2 -->
              <text x="16" y="40" fill="#1D2226">3</text><text x="50" y="40" fill="#1D2226">4</text><text x="84" y="40" fill="#1D2226">5</text>
              <text x="118" y="40" fill="#1D2226">6</text><text x="152" y="40" fill="#1D2226">7</text><text x="186" y="40" fill="#1D2226">8</text><text x="220" y="40" fill="#1D2226">9</text>
              <!-- Row 3 -->
              <text x="16" y="66" fill="#1D2226">10</text><text x="50" y="66" fill="#1D2226">11</text><text x="84" y="66" fill="#1D2226">12</text>
              <text x="118" y="66" fill="#1D2226">13</text><text x="152" y="66" fill="#1D2226">14</text><text x="186" y="66" fill="#1D2226">15</text><text x="220" y="66" fill="#1D2226">16</text>
              <!-- Row 4 - today highlighted -->
              <text x="16" y="92" fill="#1D2226">17</text><text x="50" y="92" fill="#1D2226">18</text><text x="84" y="92" fill="#1D2226">19</text>
              <text x="118" y="92" fill="#1D2226">20</text>
              <circle cx="152" cy="88" r="13" fill="#FF7D4F"/>
              <text x="152" y="92" fill="#FFFFFF" font-weight="700">21</text>
              <text x="186" y="92" fill="#1D2226">22</text><text x="220" y="92" fill="#1D2226">23</text>
              <!-- Row 5 -->
              <text x="16" y="118" fill="#1D2226">24</text><text x="50" y="118" fill="#1D2226">25</text><text x="84" y="118" fill="#1D2226">26</text>
              <text x="118" y="118" fill="#1D2226">27</text><text x="152" y="118" fill="#1D2226">28</text><text x="186" y="118" fill="#1D2226">29</text><text x="220" y="118" fill="#1D2226">30</text>
              <!-- Row 6 -->
              <text x="16" y="144" fill="#1D2226">31</text>
            </g>

            <!-- Reminder card -->
            <rect x="22" y="370" width="236" height="78" rx="18" fill="#FFF0EB" stroke="#FFD9C7" stroke-width="1"/>
            <g transform="translate(38, 386)">
              <circle cx="14" cy="14" r="14" fill="#FF7D4F"/>
              <!-- Bell icon -->
              <g transform="translate(6, 5)" stroke="#FFFFFF" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 14H2L4 11V8a4 4 0 0 1 8 0v3l2 3z"/>
                <path d="M6 16a2 2 0 0 0 4 0"/>
              </g>
            </g>
            <text x="78" y="400" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="13" font-weight="700" fill="#1D2226">{labels.reminder}</text>
            <text x="78" y="420" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="11" font-weight="500" fill="#86868b">{labels.reminderTime}</text>
            <rect x="78" y="430" width="48" height="14" rx="7" fill="#FFFFFF"/>
            <text x="102" y="441" text-anchor="middle" font-family="-apple-system, 'PingFang TC', sans-serif" font-size="9" font-weight="600" fill="#FF7D4F">每月</text>

            <!-- Note card -->
            <rect x="22" y="460" width="236" height="60" rx="18" fill="#FFF9E0" stroke="#FFF3C4" stroke-width="1"/>
            <g transform="translate(38, 472)">
              <circle cx="14" cy="14" r="14" fill="#FFD400"/>
              <text x="14" y="19" text-anchor="middle" font-family="-apple-system, sans-serif" font-size="14" font-weight="800" fill="#1D2226">📝</text>
            </g>
            <rect x="78" y="476" width="120" height="6" rx="3" fill="#1D2226" opacity="0.15"/>
            <rect x="78" y="488" width="160" height="6" rx="3" fill="#1D2226" opacity="0.10"/>
            <rect x="78" y="500" width="80" height="6" rx="3" fill="#1D2226" opacity="0.10"/>

            <rect x="100" y="538" width="80" height="4" rx="2" fill="#1D2226"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-900 mb-1">{i18n.screenshots.items[2].title}</h3>
        <p class="text-sm text-gray-500 text-center max-w-[220px]">{i18n.screenshots.items[2].desc}</p>
      </div>

    </div>
  </div>
</section>

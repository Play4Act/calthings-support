---
import Layout from '../../../layouts/Layout.astro';
import { t, LANGS, type Lang } from '../../../i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const i18n = t[lang];

const allPosts = await getCollection('announcements');
// With glob loader, id is like "zh/2026-04-launch"
const posts = allPosts
  .filter(p => p.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout lang={lang} title={i18n.announcements.title} currentPage="announcements">
  <div class="bg-gradient-to-br from-ocean-deep via-ocean-blue to-ocean-light text-white py-12 px-4 text-center">
    <div class="inline-flex items-center justify-center w-14 h-14 bg-white/20 backdrop-blur-sm border border-white/30 rounded-2xl text-2xl mb-4">📢</div>
    <h1 class="text-3xl font-extrabold tracking-tight">{i18n.announcements.title}</h1>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-10">
    {posts.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-gray-100">
        <p class="text-5xl mb-4">📭</p>
        <p class="text-gray-500">{i18n.announcements.empty}</p>
      </div>
    ) : (
      <div class="space-y-4">
        {posts.map(post => {
          const slug = post.id.replace(`${lang}/`, '');
          return (
            <a href={`/${lang}/announcements/${slug}/`} class="block bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-ocean-foam hover:shadow-md transition-all duration-200 group">
              <p class="text-xs text-gray-400 mb-2 flex items-center gap-1.5">
                <span>📅</span>
                {i18n.announcements.publishedOn} {post.data.date}
              </p>
              <h2 class="text-base font-bold text-gray-800 group-hover:text-ocean-deep transition-colors mb-2">{post.data.title}</h2>
              <p class="text-sm text-gray-500 line-clamp-2">{post.data.summary}</p>
              <p class="mt-3 text-sm text-ocean-blue font-medium">{i18n.announcements.readMore} →</p>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>

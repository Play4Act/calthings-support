---
import Layout from '../../../layouts/Layout.astro';
import { t, LANGS, type Lang } from '../../../i18n';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('announcements');
  return allPosts.map(post => {
    // post.id is like "zh/2026-04-launch"
    const [lang, ...slugParts] = post.id.split('/');
    return {
      params: { lang, slug: slugParts.join('/') },
      props: { post },
    };
  });
}

const { lang } = Astro.params as { lang: Lang };
const { post } = Astro.props;
const i18n = t[lang];
const { Content } = await render(post);
---

<Layout lang={lang} title={post.data.title} currentPage="announcements">
  <div class="bg-gradient-to-br from-ocean-deep via-ocean-blue to-ocean-light text-white py-12 px-4 text-center">
    <p class="text-white/70 text-sm mb-2">{i18n.announcements.publishedOn} {post.data.date}</p>
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight max-w-xl mx-auto">{post.data.title}</h1>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-10">
    <a href={`/${lang}/announcements/`} class="inline-flex items-center text-sm text-ocean-blue font-medium mb-6 hover:underline">
      {i18n.announcements.backToList}
    </a>

    <article class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100 prose prose-sm max-w-none
      prose-headings:text-gray-800 prose-headings:font-bold
      prose-p:text-gray-600 prose-p:leading-relaxed
      prose-a:text-ocean-blue prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-800
      prose-ul:text-gray-600 prose-li:marker:text-ocean-blue">
      <Content />
    </article>

    <div class="mt-6 text-center">
      <a href={`/${lang}/announcements/`} class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-ocean-blue transition-colors">
        {i18n.announcements.backToList}
      </a>
    </div>
  </div>
</Layout>

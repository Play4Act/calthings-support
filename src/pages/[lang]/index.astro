---
import Layout from '../../layouts/Layout.astro';
import { t, LANGS, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const i18n = t[lang];

const featureColorMap: Record<string, string> = {
  blue:   'bg-blue-50 text-blue-600',
  coral:  'bg-orange-50 text-orange-500',
  green:  'bg-emerald-50 text-emerald-600',
  yellow: 'bg-yellow-50 text-yellow-600',
  purple: 'bg-purple-50 text-purple-600',
  mint:   'bg-teal-50 text-teal-600',
};
---

<Layout lang={lang} currentPage="home">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-deep via-ocean-blue to-ocean-light text-white text-center py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-white/10 rounded-full blur-3xl -translate-y-1/2"></div>
    </div>
    <div class="relative z-10 max-w-xl mx-auto">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-white/20 backdrop-blur-sm border border-white/30 rounded-3xl mb-5 shadow-lg overflow-hidden">
        <img src="/icon-256.png" alt="CalThings" class="w-16 h-16 rounded-2xl" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3">CalThings</h1>
      <p class="text-lg opacity-90 mb-8">{i18n.hero.subtitle}</p>
      <a
        href="https://apps.apple.com/tw/app/calthings/id6757834850"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-white text-ocean-deep font-bold px-7 py-3.5 rounded-2xl shadow-xl hover:-translate-y-0.5 hover:shadow-2xl transition-all duration-200"
      >
        <svg class="w-5 h-5 fill-ocean-deep" viewBox="0 0 384 512">
          <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
        </svg>
        {i18n.hero.downloadBtn}
      </a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-10 space-y-6">

    <!-- About / Features -->
    <section class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center text-lg">📱</span>
        <h2 class="text-xl font-bold">{i18n.about.title}</h2>
      </div>
      <p class="text-gray-600 text-sm mb-6">{i18n.about.desc}</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {i18n.features.map(f => (
          <div class="bg-gray-50 hover:bg-blue-50/50 rounded-xl p-4 border border-gray-100 hover:border-ocean-foam transition-colors duration-200 group">
            <div class={`w-9 h-9 rounded-lg flex items-center justify-center text-lg mb-2 ${featureColorMap[f.color] ?? 'bg-gray-100'}`}>
              {f.icon}
            </div>
            <p class="text-sm font-semibold text-gray-800 mb-1">{f.title}</p>
            <p class="text-xs text-gray-500 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Premium Banner -->
    <section class="bg-gradient-to-br from-ocean-deep via-ocean-blue to-ocean-light rounded-2xl p-7 text-white shadow-md relative overflow-hidden">
      <div class="absolute top-0 right-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-lg">⭐</span>
          <h2 class="text-xl font-bold">{i18n.premium.title}</h2>
        </div>
        <p class="text-white/90 text-sm mb-4">{i18n.premium.desc}</p>
        <div class="flex flex-wrap gap-2">
          {i18n.premium.tags.map(tag => (
            <span class="bg-white/20 backdrop-blur-sm text-sm px-3 py-1 rounded-lg font-medium">{tag}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ preview -->
    <section class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-yellow-50 flex items-center justify-center text-lg">❓</span>
          <h2 class="text-xl font-bold">{i18n.faq.title}</h2>
        </div>
        <a href={`/${lang}/faq/`} class="text-sm text-ocean-blue font-medium hover:underline">
          {lang === 'zh' ? '查看全部 →' : lang === 'en' ? 'View all →' : 'すべて見る →'}
        </a>
      </div>
      <div class="divide-y divide-gray-100">
        {i18n.faq.items.slice(0, 3).map(item => (
          <div class="py-4 first:pt-0 last:pb-0">
            <p class="text-sm font-semibold text-gray-800 mb-1.5 flex items-start gap-2">
              <span class="shrink-0 mt-0.5 w-5 h-5 rounded-md bg-ocean-foam text-ocean-deep text-xs font-bold flex items-center justify-center">Q</span>
              {item.q}
            </p>
            <p class="text-sm text-gray-500 pl-7">{item.a}</p>
          </div>
        ))}
      </div>
      <a href={`/${lang}/faq/`} class="mt-5 flex items-center justify-center gap-1.5 text-sm text-ocean-blue font-medium py-2.5 border border-ocean-foam rounded-xl hover:bg-ocean-foam/30 transition-colors">
        {lang === 'zh' ? '查看所有常見問題' : lang === 'en' ? 'View all FAQs' : 'すべての質問を見る'}
      </a>
    </section>

    <!-- Contact -->
    <section class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center text-lg">📧</span>
        <h2 class="text-xl font-bold">{i18n.contact.title}</h2>
      </div>
      <p class="text-gray-600 text-sm mb-4">{i18n.contact.desc}</p>
      <a
        href="mailto:play4act.app@gmail.com"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-ocean-deep to-ocean-blue text-white font-semibold px-5 py-2.5 rounded-xl shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
      >
        ✉️ play4act.app@gmail.com
      </a>
    </section>

  </div>
</Layout>
